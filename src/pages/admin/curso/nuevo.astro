---
import Layout from '../../../layouts/Layout.astro';

export const prerender = false;
---
<Layout title="Create course - AprendePlus" currentPath="/admin">
  <div class="min-h-screen bg-white py-12">
    <div class="max-w-3xl mx-auto px-6">
      <div class="mb-8">
        <a href="/admin" class="inline-flex items-center gap-2 text-[#2F7FBF] hover:underline mb-4">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Back to course list
        </a>
        <h1 class="text-3xl font-bold text-[#2B2B2B] mb-2">Create new course</h1>
        <p class="text-gray-600">Fill in the information to add a new course. After creating, you can assign learners on the course edit page.</p>
      </div>

      <div id="form-error" class="hidden mb-4 p-3 bg-red-50 text-red-700 rounded-lg"></div>

      <form id="course-form" class="space-y-6 bg-white border border-gray-200 rounded-xl p-6">
        <div>
          <label for="title" class="block text-sm font-medium text-[#2B2B2B] mb-2">Course title *</label>
          <input type="text" id="title" name="title" required placeholder="e.g. Full Stack Web Development" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2F7FBF] focus:border-transparent" />
        </div>
        <div>
          <label for="description" class="block text-sm font-medium text-[#2B2B2B] mb-2">Description *</label>
          <textarea id="description" name="description" rows="4" required placeholder="Course description..." class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2F7FBF] focus:border-transparent"></textarea>
        </div>
        <div>
          <label class="block text-sm font-medium text-[#2B2B2B] mb-2">Choose an image for the course card</label>
          <input type="hidden" id="header-image-id" name="header_image_id" value="" />
          <div id="header-image-picker" class="flex flex-wrap gap-3 mt-2">
            <button type="button" class="header-image-option border-2 border-[#2F7FBF] ring-2 ring-[#2F7FBF] rounded-lg overflow-hidden w-24 h-24 flex flex-col items-center justify-center bg-gray-100 hover:bg-gray-50 transition-colors cursor-pointer" data-id="">
              <span class="text-2xl text-gray-400">📷</span>
              <span class="text-xs text-gray-500 mt-1">No image</span>
            </button>
          </div>
        </div>
        <div>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="course-default" class="rounded border-gray-300 text-[#2F7FBF] focus:ring-[#2F7FBF]" />
            <span class="text-sm font-medium text-[#2B2B2B]">Default course?</span>
          </label>
          <p class="text-xs text-gray-500 mt-1">Default courses are auto-assigned when creating a new user with "New user?" checked.</p>
        </div>
        <div class="flex justify-end gap-3 pt-4">
          <a href="/admin" class="px-6 py-3 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">Cancel</a>
          <button type="submit" class="px-6 py-3 bg-[#2F7FBF] text-white rounded-lg hover:bg-[#256A9E] transition-colors font-medium cursor-pointer">Create course</button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { get, post } from '@/lib/api';
  import type { AdminCourse, CourseHeaderImageOption } from '@/lib/api-types';

  const form = document.getElementById('course-form') as HTMLFormElement;
  const errorEl = document.getElementById('form-error');
  const headerImageInput = document.getElementById('header-image-id') as HTMLInputElement;
  const headerImagePicker = document.getElementById('header-image-picker');

  function setSelectedHeaderImage(id: string) {
    if (headerImageInput) headerImageInput.value = id;
    headerImagePicker?.querySelectorAll('.header-image-option').forEach((el) => {
      el.classList.remove('border-[#2F7FBF]', 'ring-2', 'ring-[#2F7FBF]');
      el.classList.add('border-gray-300');
    });
    const selected = headerImagePicker?.querySelector(`.header-image-option[data-id="${id}"]`);
    if (selected) {
      selected.classList.remove('border-gray-300');
      selected.classList.add('border-[#2F7FBF]', 'ring-2', 'ring-[#2F7FBF]');
    }
  }

  (async function initHeaderImages() {
    try {
      const list = await get<CourseHeaderImageOption[] | { course_header_images: CourseHeaderImageOption[] }>('/admin/course-header-images');
      const options = Array.isArray(list) ? list : (list?.course_header_images ?? []);
      if (headerImagePicker) {
        const noImageBtn = headerImagePicker.querySelector('.header-image-option[data-id=""]');
        noImageBtn?.addEventListener('click', () => setSelectedHeaderImage(''));
        // Google Drive "uc?export=view" URLs often don't work in <img>. Use thumbnail endpoint when we have the file id.
        function imageUrlForPicker(opt: CourseHeaderImageOption): string {
          let id = opt.google_drive_file_id;
          if (!id && opt.url) {
            const m = opt.url.match(/[?&]id=([^&]+)/);
            if (m) id = m[1];
          }
          if (id) return `https://drive.google.com/thumbnail?id=${encodeURIComponent(id)}&sz=w200`;
          return (opt.url || '').replace(/&amp;/g, '&');
        }
        options.forEach((opt) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'header-image-option border-2 border-gray-300 rounded-lg overflow-hidden w-24 h-24 flex-shrink-0 hover:border-[#2F7FBF] transition-colors cursor-pointer';
          btn.dataset.id = String(opt.id);
          const img = document.createElement('img');
          img.src = imageUrlForPicker(opt);
          img.alt = opt.label || '';
          img.className = 'w-full h-full object-cover';
          img.referrerPolicy = 'no-referrer';
          btn.appendChild(img);
          btn.addEventListener('click', () => setSelectedHeaderImage(String(opt.id)));
          headerImagePicker.appendChild(btn);
        });
      }
    } catch {
      // Leave only "No image" if endpoint fails
    }
  })();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (errorEl) { errorEl.classList.add('hidden'); errorEl.textContent = ''; }
    const title = (form.querySelector('#title') as HTMLInputElement)?.value?.trim();
    const description = (form.querySelector('#description') as HTMLTextAreaElement)?.value?.trim();
    const defaultCourse = (form.querySelector('#course-default') as HTMLInputElement)?.checked ?? false;
    const headerImageIdRaw = headerImageInput?.value?.trim();
    const headerImageId = headerImageIdRaw ? Number(headerImageIdRaw) : null;
    if (!title || !description) return;
    try {
      const course = await post<AdminCourse>('/admin/courses', { course: { title, description, default: defaultCourse, header_image_id: headerImageId } });
      window.location.href = `/admin/curso/${course.id}/editar`;
    } catch (err: unknown) {
      const apiErr = err as { status?: number; body?: { error?: string; errors?: string[] } };
      if (apiErr.status === 403) {
        window.location.href = '/admin/forbidden';
        return;
      }
      const msg = apiErr?.body?.error || (Array.isArray(apiErr?.body?.errors) && apiErr.body.errors[0]) || 'Error creating course';
      if (errorEl) { errorEl.textContent = msg; errorEl.classList.remove('hidden'); }
    }
  });
</script>
