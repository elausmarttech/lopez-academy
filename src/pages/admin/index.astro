---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;
---
<Layout title="Course Management - AprendePlus" currentPath="/admin">
  <div class="min-h-screen bg-white py-12">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold text-[#2B2B2B] mb-2">Course Management</h1>
          <p class="text-gray-600">Manage platform content</p>
        </div>
        <div class="flex items-center gap-3">
          <a href="/admin/curso/nuevo" class="flex items-center gap-2 bg-[#2F7FBF] text-white px-6 py-3 rounded-lg hover:bg-[#256A9E] transition-colors">
            + Create Course
          </a>
        </div>
      </div>

      <div class="mb-6 flex flex-col sm:flex-row gap-4 sm:items-center">
        <input type="text" id="admin-search" placeholder="Search courses..." class="w-full max-w-md px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2F7FBF] focus:border-transparent" />
        <div class="flex items-center gap-2">
          <label for="admin-sort" class="text-sm font-medium text-[#2B2B2B] whitespace-nowrap">Order by</label>
          <select id="admin-sort" class="px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2F7FBF] focus:border-transparent bg-white min-w-[180px]">
            <option value="newest-first">Newest first</option>
            <option value="oldest-first">Oldest first</option>
            <option value="name-az">Name A–Z</option>
            <option value="name-za">Name Z–A</option>
          </select>
        </div>
      </div>

      <div id="admin-error" class="hidden mb-4 p-3 bg-red-50 text-red-700 rounded-lg"></div>

      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <table class="w-full">
          <thead class="bg-[#EEEEEE]">
            <tr>
              <th class="text-left px-6 py-4 text-sm font-semibold text-[#2B2B2B]">Course</th>
              <th class="text-left px-6 py-4 text-sm font-semibold text-[#2B2B2B]">Description</th>
              <th class="text-center px-6 py-4 text-sm font-semibold text-[#2B2B2B]">Lessons</th>
              <th class="text-center px-6 py-4 text-sm font-semibold text-[#2B2B2B]">Quizzes</th>
              <th class="text-center px-6 py-4 text-sm font-semibold text-[#2B2B2B]">Students</th>
              <th class="text-center px-6 py-4 text-sm font-semibold text-[#2B2B2B]">Actions</th>
            </tr>
          </thead>
          <tbody id="admin-tbody" class="divide-y divide-gray-200">
            <tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">Loading...</td></tr>
          </tbody>
        </table>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
        <div class="bg-[#FFF0CE] rounded-xl p-6">
          <p class="text-sm text-gray-700 mb-1">Total Courses</p>
          <p id="admin-total" class="text-3xl font-bold text-[#2B2B2B]">0</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { get, del } from '@/lib/api';
  import type { AdminCourse } from '@/lib/api-types';

  const tbody = document.getElementById('admin-tbody');
  const searchEl = document.getElementById('admin-search') as HTMLInputElement;
  const sortEl = document.getElementById('admin-sort') as HTMLSelectElement;
  const totalEl = document.getElementById('admin-total');
  const errorEl = document.getElementById('admin-error');

  let allCourses: AdminCourse[] = [];

  function showError(msg: string) {
    if (errorEl) {
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
    }
  }

  function escapeHtml(s: string): string {
    const div = document.createElement('div');
    div.textContent = s;
    return div.innerHTML;
  }

  function imageSrcForHeaderUrl(url: string | null | undefined): string | null {
    if (!url) return null;
    const decoded = url.replace(/&amp;/g, '&');
    const m = decoded.match(/[?&]id=([^&]+)/);
    if (m) return `https://drive.google.com/thumbnail?id=${encodeURIComponent(m[1])}&sz=w200`;
    return decoded;
  }

  function sortCourses(courses: AdminCourse[]): AdminCourse[] {
    const arr = [...courses];
    const by = sortEl?.value ?? 'newest-first';
    if (by === 'newest-first') arr.sort((a, b) => (b.created_at || '').localeCompare(a.created_at || ''));
    else if (by === 'oldest-first') arr.sort((a, b) => (a.created_at || '').localeCompare(b.created_at || ''));
    else if (by === 'name-az') arr.sort((a, b) => (a.title || '').localeCompare(b.title || '', undefined, { sensitivity: 'base' }));
    else if (by === 'name-za') arr.sort((a, b) => (b.title || '').localeCompare(a.title || '', undefined, { sensitivity: 'base' }));
    return arr;
  }

  function applySortAndFilter() {
    const q = (searchEl?.value ?? '').toLowerCase().trim();
    const sorted = sortCourses(allCourses);
    const filtered = q
      ? sorted.filter((c) => (c.title || '').toLowerCase().includes(q) || (c.description || '').toLowerCase().includes(q))
      : sorted;
    render(filtered);
    if (totalEl) totalEl.textContent = String(filtered.length);
  }

  function render(courses: AdminCourse[]) {
    if (!tbody) return;
    tbody.innerHTML = courses
      .map(
        (c) => {
          const imgSrc = imageSrcForHeaderUrl((c as { header_image_url?: string | null }).header_image_url);
          const thumb = imgSrc
            ? `<img src="${escapeHtml(imgSrc)}" alt="" class="w-12 h-12 rounded object-cover flex-shrink-0" referrerpolicy="no-referrer" />`
            : '<div class="w-12 h-12 rounded bg-[#EEEEEE] flex items-center justify-center flex-shrink-0 text-lg text-gray-400">📚</div>';
          return `
      <tr class="admin-course-row hover:bg-[#FFF0CE]/30 transition-colors" data-title="${escapeHtml((c.title || '').toLowerCase())}" data-description="${escapeHtml((c.description || '').toLowerCase())}">
        <td class="px-6 py-4">
          <div class="flex items-center gap-3">
            ${thumb}
            <p class="font-medium text-[#2B2B2B]">${escapeHtml(c.title)}</p>
          </div>
        </td>
        <td class="px-6 py-4 text-sm text-gray-600 max-w-[280px]" title="${escapeHtml(c.description || '')}"><div class="line-clamp-2 overflow-hidden" style="display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; word-break: normal;">${escapeHtml(c.description || '')}</div></td>
        <td class="px-6 py-4 text-center text-sm text-gray-700">${c.lessons_count != null ? c.lessons_count : '—'}</td>
        <td class="px-6 py-4 text-center text-sm text-gray-700">${c.quizzes_count != null ? c.quizzes_count : '—'}</td>
        <td class="px-6 py-4 text-center text-sm text-gray-700">${c.students_count != null ? c.students_count : '—'}</td>
        <td class="px-6 py-4">
          <div class="flex items-center justify-center gap-2">
            <a href="/curso/${c.id}" class="p-2 text-gray-600 hover:bg-[#FFF0CE] rounded-lg transition-colors" title="View and start course">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            </a>
            <a href="/admin/curso/${c.id}/editar" class="p-2 text-[#2F7FBF] hover:bg-[#FFF0CE] rounded-lg transition-colors" title="Edit">✏️</a>
            <button type="button" class="admin-delete p-2 text-red-500 hover:bg-red-50 rounded-lg transition-colors cursor-pointer" data-id="${c.id}" title="Delete">🗑</button>
          </div>
        </td>
      </tr>
    `;
        }
      )
      .join('');

    tbody.querySelectorAll('.admin-delete').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        if (!id || !confirm('Delete this course?')) return;
        try {
          await del(`/admin/courses/${id}`);
          load();
        } catch (e: unknown) {
          const err = e as { body?: { error?: string; errors?: string[] } };
          showError(err?.body?.error || (Array.isArray(err?.body?.errors) && err.body.errors[0]) || 'Error deleting');
        }
      });
    });
  }

  async function load() {
    if (errorEl) errorEl.classList.add('hidden');
    try {
      const data = (await get<AdminCourse[]>('/admin/courses')) ?? [];
      allCourses = data;
      applySortAndFilter();
    } catch (e: unknown) {
      const err = e as { status?: number; body?: { error?: string } };
      if (err.status === 403) {
        window.location.href = '/admin/forbidden';
        return;
      }
      showError(err?.body?.error || 'Error loading courses');
      if (tbody) tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-red-600">Error loading</td></tr>';
    }
  }

  searchEl?.addEventListener('input', applySortAndFilter);
  sortEl?.addEventListener('change', applySortAndFilter);

  load();
</script>
