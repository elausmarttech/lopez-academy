---
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = false;
const { courseId, itemId } = Astro.params;
---
<BaseLayout title="Curso - AprendePlus" showFooter={false}>
  <div id="curso-item-detail-root" class="min-h-screen bg-[#F8F7F4] flex" data-course-id={courseId ?? ''} data-item-id={itemId ?? ''}>
    <aside id="course-outline-sidebar" class="w-72 flex-shrink-0 bg-white border-r border-gray-200 min-h-screen sticky top-0 overflow-y-auto">
      <div class="p-4 border-b border-gray-200">
        <a href={courseId ? `/curso/${courseId}` : '#'} class="inline-flex items-center gap-2 text-[#2F7FBF] hover:text-[#256A9E] text-sm mb-3 cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Back to course
        </a>
        <h2 id="sidebar-course-title" class="font-semibold text-[#2B2B2B] text-sm">Loading...</h2>
      </div>
      <nav id="sidebar-outline" class="p-3 space-y-1 text-sm">
        <p class="text-gray-500 py-2">Loading outline...</p>
      </nav>
    </aside>
    <main class="flex-1 p-6 lg:p-8 overflow-auto">
      <div id="item-content" class="max-w-4xl mx-auto">
        <p class="text-gray-500">Loading...</p>
      </div>
      <div id="item-error" class="hidden max-w-4xl mx-auto mt-6 text-red-600"></div>
    </main>
  </div>

  <script>
    import { get, post } from '@/lib/api';
    import type {
      CourseDetail,
      CourseItemRef,
      CurrentItemPayload,
      CompleteLessonResponse,
      QuizDetail,
      QuizQuestionResult,
      QuizSubmitResponse,
      LessonItem,
      LessonSection,
    } from '@/lib/api-types';

    const root = document.getElementById('curso-item-detail-root');
    const courseId = root?.getAttribute('data-course-id') ?? '';
    const itemIdStr = root?.getAttribute('data-item-id') ?? '';
    const itemId = itemIdStr ? parseInt(itemIdStr, 10) : null;

    function escapeHtml(s: string): string {
      const div = document.createElement('div');
      div.textContent = s;
      return div.innerHTML;
    }

    function showError(msg: string) {
      const content = document.getElementById('item-content');
      const errEl = document.getElementById('item-error');
      if (content) content.innerHTML = '';
      if (errEl) {
        errEl.textContent = msg;
        errEl.classList.remove('hidden');
      }
    }

    function renderSidebarWithSections(
      course: CourseDetail,
      currentItemId: number | null,
      currentSectionIndex: number | null
    ) {
      const titleEl = document.getElementById('sidebar-course-title');
      const outlineEl = document.getElementById('sidebar-outline');
      if (titleEl) titleEl.textContent = course.title ?? 'Course';
      if (!outlineEl || !course.course_items?.length) {
        if (outlineEl) outlineEl.innerHTML = '<p class="text-gray-500 py-2">No items in this course.</p>';
        return;
      }
      const nextId = course.next_item?.id ?? null;
      const lessonsOnly = course.course_items.filter((ci) => ci.item_type === 'Lesson');
      let globalIdx = 0;
      const parts: string[] = [];
      for (let i = 0; i < course.course_items.length; i++) {
        const item = course.course_items[i];
        const isQuiz = item.item_type === 'Quiz';
        const isLessonWithSections = !isQuiz && (item.lesson_sections?.length ?? 0) > 0;
        const completedSectionIds = (item as CourseItemRef).completed_section_ids ?? [];
        const isCurrentItem = item.id === currentItemId;

        if (isQuiz) {
          globalIdx++;
          const isCompleted = item.completed;
          const isNext = item.id === nextId;
          const isLocked = !isCompleted && !isNext;
          const href = isLocked ? '#' : `/curso/${courseId}/item/${item.id}`;
          const linkClass = isCurrentItem && currentSectionIndex === null
            ? 'flex items-center gap-3 px-3 py-2 rounded-lg bg-[#2F7FBF]/15 border-l-2 border-[#2F7FBF] text-[#2F7FBF] font-medium cursor-pointer'
            : isLocked
              ? 'flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 cursor-not-allowed'
              : 'flex items-center gap-3 px-3 py-2 rounded-lg text-[#2B2B2B] hover:bg-gray-100 cursor-pointer';
          const icon = '<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>';
          const badge = isCompleted
            ? '<span class="flex-shrink-0 w-5 h-5 rounded-full bg-green-100 text-green-600 flex items-center justify-center"><svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg></span>'
            : `<span class="flex-shrink-0 w-5 h-5 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center text-xs font-medium">${globalIdx}</span>`;
          const tag = isLocked ? 'div' : 'a';
          const attrs = isLocked ? '' : ` href="${escapeHtml(href)}"`;
          parts.push(`<${tag} class="${linkClass}"${attrs}>${icon}${badge}<span class="truncate">${escapeHtml(item.title)}</span></${tag}>`);
        } else if (isLessonWithSections) {
          const sections = (item.lesson_sections ?? []).slice().sort((a, b) => (a.position ?? 0) - (b.position ?? 0));
          const lessonNum = lessonsOnly.findIndex((ci) => ci.id === item.id) + 1;
          const parentCompleted = item.completed;
          const parentIsNext = item.id === nextId;
          const parentLocked = !parentCompleted && !parentIsNext;
          const parentHref = parentLocked ? '#' : `/curso/${courseId}/item/${item.id}/section/0`;
          const expandedByDefault = isCurrentItem && currentSectionIndex !== null;
          const parentLinkClass = parentLocked
            ? 'flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 cursor-not-allowed flex-1 min-w-0'
            : isCurrentItem
              ? 'flex items-center gap-3 px-3 py-2 rounded-lg bg-[#2F7FBF]/15 border-l-2 border-[#2F7FBF] text-[#2F7FBF] font-medium cursor-pointer flex-1 min-w-0'
              : 'flex items-center gap-3 px-3 py-2 rounded-lg text-[#2B2B2B] hover:bg-gray-100 cursor-pointer flex-1 min-w-0';
          const parentBadge = parentCompleted
            ? '<span class="flex-shrink-0 w-5 h-5 rounded-full bg-green-100 text-green-600 flex items-center justify-center"><svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg></span>'
            : `<span class="flex-shrink-0 w-5 h-5 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center text-xs font-medium">${lessonNum}</span>`;
          const bookIcon = '<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>';
          const chevronSvg = expandedByDefault ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>' : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>';
          const chevronBtn = `<button type="button" class="sidebar-chevron-toggle flex-shrink-0 p-1 rounded hover:bg-gray-100 cursor-pointer" aria-label="${expandedByDefault ? 'Collapse sections' : 'Expand sections'}"><svg class="w-4 h-4 text-[#2B2B2B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">${chevronSvg}</svg></button>`;
          const parentTag = parentLocked ? 'div' : 'a';
          const parentAttrs = parentLocked ? '' : ` href="${escapeHtml(parentHref)}"`;
          parts.push(`<div class="sidebar-lesson-sections" data-lesson-item-id="${item.id}" data-expanded="${expandedByDefault}"><div class="flex items-center gap-1 rounded-lg ${isCurrentItem ? 'bg-[#2F7FBF]/15 border-l-2 border-[#2F7FBF]' : ''}"><${parentTag} class="${parentLinkClass}"${parentAttrs}>${bookIcon}<span class="flex-shrink-0 w-5 h-5 flex items-center justify-center">${parentBadge}</span><span class="truncate">${escapeHtml(item.title)}</span></${parentTag}>${chevronBtn}</div><div class="sidebar-section-rows" style="${expandedByDefault ? '' : 'display:none'}">`);
          for (let s = 0; s < sections.length; s++) {
            const sec = sections[s];
            const secCompleted = completedSectionIds.includes(sec.id);
            const prevSectionsComplete = s === 0 || sections.slice(0, s).every((prev) => completedSectionIds.includes(prev.id));
            const isLocked = parentLocked || !secCompleted && !prevSectionsComplete;
            const secHref = isLocked ? '#' : `/curso/${courseId}/item/${item.id}/section/${s}`;
            const isCurrent = isCurrentItem && currentSectionIndex === s;
            const secLinkClass = isCurrent
              ? 'flex items-center gap-3 pl-8 pr-3 py-2 rounded-lg bg-[#2F7FBF]/15 border-l-2 border-[#2F7FBF] text-[#2F7FBF] font-medium cursor-pointer'
              : isLocked
                ? 'flex items-center gap-3 pl-8 pr-3 py-2 rounded-lg text-gray-400 cursor-not-allowed'
                : 'flex items-center gap-3 pl-8 pr-3 py-2 rounded-lg text-[#2B2B2B] hover:bg-gray-100 cursor-pointer';
            const secBadge = secCompleted
              ? '<span class="flex-shrink-0 w-5 h-5 rounded-full bg-green-100 text-green-600 flex items-center justify-center"><svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg></span>'
              : `<span class="flex-shrink-0 w-5 h-5 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center text-xs font-medium">${lessonNum}.${s + 1}</span>`;
            const secTag = isLocked ? 'div' : 'a';
            const secAttrs = isLocked ? '' : ` href="${escapeHtml(secHref)}"`;
            parts.push(`<${secTag} class="${secLinkClass}"${secAttrs}>${secBadge}<span class="truncate">${escapeHtml(sec.title)}</span></${secTag}>`);
          }
          parts.push('</div></div>');
          globalIdx++;
        } else {
          globalIdx++;
          const isCompleted = item.completed;
          const isNext = item.id === nextId;
          const isLocked = !isCompleted && !isNext;
          const href = isLocked ? '#' : `/curso/${courseId}/item/${item.id}`;
          const linkClass = isCurrentItem && currentSectionIndex === null
            ? 'flex items-center gap-3 px-3 py-2 rounded-lg bg-[#2F7FBF]/15 border-l-2 border-[#2F7FBF] text-[#2F7FBF] font-medium cursor-pointer'
            : isLocked
              ? 'flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 cursor-not-allowed'
              : 'flex items-center gap-3 px-3 py-2 rounded-lg text-[#2B2B2B] hover:bg-gray-100 cursor-pointer';
          const icon = '<svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>';
          const badge = isCompleted
            ? '<span class="flex-shrink-0 w-5 h-5 rounded-full bg-green-100 text-green-600 flex items-center justify-center"><svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg></span>'
            : `<span class="flex-shrink-0 w-5 h-5 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center text-xs font-medium">${globalIdx}</span>`;
          const tag = isLocked ? 'div' : 'a';
          const attrs = isLocked ? '' : ` href="${escapeHtml(href)}"`;
          parts.push(`<${tag} class="${linkClass}"${attrs}>${icon}${badge}<span class="truncate">${escapeHtml(item.title)}</span></${tag}>`);
        }
      }
      outlineEl.innerHTML = parts.join('');
      outlineEl.querySelectorAll('.sidebar-chevron-toggle').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const wrapper = (e.currentTarget as HTMLElement).closest('.sidebar-lesson-sections');
          if (!wrapper) return;
          const sectionRows = wrapper.querySelector('.sidebar-section-rows') as HTMLElement;
          const isExpanded = wrapper.getAttribute('data-expanded') === 'true';
          wrapper.setAttribute('data-expanded', String(!isExpanded));
          if (sectionRows) sectionRows.style.display = isExpanded ? 'none' : '';
          const target = e.currentTarget as HTMLElement;
          const svg = target.querySelector('svg');
          if (svg) {
            svg.innerHTML = isExpanded
              ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>'
              : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>';
          }
          target.setAttribute('aria-label', isExpanded ? 'Expand sections' : 'Collapse sections');
        });
      });
    }

    async function loadItem(): Promise<void> {
      const content = document.getElementById('item-content');
      const errorEl = document.getElementById('item-error');
      if (errorEl) errorEl.classList.add('hidden');

      if (!courseId || !itemId) {
        showError('Invalid parameters');
        return;
      }

      try {
        // Get course detail to find the item and check completion status
        const course = await get<CourseDetail>(`/courses/${courseId}`);
        renderSidebarWithSections(course, itemId, null);
        const courseItem = course.course_items?.find((item) => item.id === itemId);
        
        if (!courseItem) {
          showError('Item not found');
          return;
        }

        const isCompleted = courseItem.completed;
        const currentIndex = course.course_items?.findIndex((item) => item.id === itemId) ?? -1;
        const prevItem = currentIndex > 0 ? course.course_items?.[currentIndex - 1] : null;
        const nextItem = currentIndex >= 0 && course.course_items ? course.course_items[currentIndex + 1] : null;

        // Enforce order: if any previous item is not completed, don't show this item
        const items = course.course_items ?? [];
        const allPreviousCompleted = currentIndex <= 0 || items.slice(0, currentIndex).every((ci) => ci.completed);
        if (!allPreviousCompleted) {
          const firstIncomplete = items.find((ci) => !ci.completed);
          if (content) {
            content.innerHTML = `
              <div class="bg-white rounded-xl p-8 text-center border border-gray-200">
                <h2 class="text-xl font-bold text-[#2B2B2B] mb-2">Complete previous items first</h2>
                <p class="text-gray-600 mb-6">You need to complete the lessons and activities in order before accessing this one.</p>
                <a href="/curso/${courseId}/item/${firstIncomplete?.id ?? items[0]?.id}" class="inline-flex items-center gap-2 bg-[#2F7FBF] text-white px-6 py-3 rounded-lg hover:bg-[#256A9E] cursor-pointer">Go to next item</a>
                <a href="/curso/${courseId}" class="block mt-3 text-[#2F7FBF] hover:underline">Back to course</a>
              </div>
            `;
          }
          return;
        }

        if (courseItem.item_type === 'Lesson') {
          const courseItemVideo = (courseItem as { video?: string }).video;
          const courseItemSections = (courseItem as { lesson_sections?: LessonSection[] }).lesson_sections;
          let lesson: LessonItem;

          try {
            const lessonData = await get<LessonItem>(`/courses/${courseId}/lessons/${courseItem.item_id}`);
            lesson = {
              ...lessonData,
              video: lessonData.video?.trim() || courseItemVideo?.trim() || undefined,
              lesson_sections: lessonData.lesson_sections ?? courseItemSections ?? [],
            };
          } catch {
            try {
              const currentItemData = await get<CurrentItemPayload>(`/courses/${courseId}/current_item`);
              if ('item' in currentItemData && currentItemData.item_type === 'Lesson' && currentItemData.item_id === courseItem.item_id) {
                const item = currentItemData.item as LessonItem;
                lesson = {
                  ...item,
                  video: item.video?.trim() || courseItemVideo?.trim() || undefined,
                  lesson_sections: item.lesson_sections ?? courseItemSections ?? [],
                };
              } else {
                lesson = { id: courseItem.item_id, title: courseItem.title, content: courseItem.content ?? '', video: courseItemVideo?.trim() || undefined, lesson_sections: courseItemSections ?? [] };
              }
            } catch {
              lesson = { id: courseItem.item_id, title: courseItem.title, content: courseItem.content ?? '', video: courseItemVideo?.trim() || undefined, lesson_sections: courseItemSections ?? [] };
            }
          }

          const completedBadgeHtml = `
            <span class="flex items-center gap-2 text-green-600 font-medium">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Completed
            </span>
          `;
          const prevHref = prevItem
            ? (prevItem.item_type === 'Lesson' && (prevItem.lesson_sections?.length ?? 0) > 0)
              ? `/curso/${courseId}/item/${prevItem.id}/section/${(prevItem.lesson_sections ?? []).slice().sort((a, b) => (a.position ?? 0) - (b.position ?? 0)).length - 1}`
              : `/curso/${courseId}/item/${prevItem.id}`
            : '';
          const nextHref = nextItem
            ? (nextItem.item_type === 'Lesson' && (nextItem.lesson_sections?.length ?? 0) > 0)
              ? `/curso/${courseId}/item/${nextItem.id}/section/0`
              : `/curso/${courseId}/item/${nextItem.id}`
            : '';
          if (content) {
            const navButtons = `
              <div id="lesson-nav" class="mt-8 pt-6 border-t border-gray-200 flex items-center justify-between gap-4">
                ${prevItem ? `
                  <a href="${escapeHtml(prevHref)}" class="flex items-center gap-2 bg-[#2F7FBF] text-white px-4 py-2 rounded-lg hover:bg-[#256A9E] font-medium transition-colors cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                    Back
                  </a>
                ` : '<div></div>'}
                ${isCompleted ? completedBadgeHtml : `
                  <button type="button" id="complete-lesson-btn" class="bg-[#2F7FBF] text-white px-6 py-3 rounded-lg hover:bg-[#256A9E] font-medium cursor-pointer">
                    Mark as complete
                  </button>
                `}
                ${nextItem ? `
                  <a href="${escapeHtml(nextHref)}" id="lesson-next-link" class="flex items-center gap-2 ${isCompleted ? 'bg-[#2F7FBF] text-white hover:bg-[#256A9E] cursor-pointer' : 'bg-gray-300 text-gray-500 cursor-not-allowed pointer-events-none'} px-4 py-2 rounded-lg font-medium transition-colors">
                    Next
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ` : '<div></div>'}
              </div>
            `;

            const sections = (lesson.lesson_sections ?? []).slice().sort((a, b) => (a.position ?? 0) - (b.position ?? 0));
            const useSections = sections.length > 0;
            if (useSections) {
              window.location.replace(`/curso/${courseId}/item/${itemId}/section/0`);
              return;
            }
            const lessonsOnly = (course.course_items ?? []).filter((ci) => ci.item_type === 'Lesson');
            const lessonIndexAmongLessons = lessonsOnly.findIndex((ci) => ci.id === itemId);
            const lessonNumber = lessonIndexAmongLessons >= 0 ? lessonIndexAmongLessons + 1 : 1;

            function sectionVideoHtml(url: string | undefined, label: string): string {
              if (!url?.trim()) return '';
              return `<div class="mb-4 w-full max-w-4xl mx-auto"><iframe src="${escapeHtml(url.trim())}" aria-label="${escapeHtml(label)}" width="100%" height="400" class="w-full rounded-lg" style="max-width: 1088px; aspect-ratio: 1088/637;" frameborder="0" allowfullscreen="allowfullscreen" allow="autoplay *; geolocation *; microphone *; camera *; midi *; encrypted-media *"></iframe></div>`;
            }

            const videoUrl = lesson.video?.trim();
            const videoHtml = videoUrl
              ? sectionVideoHtml(videoUrl, lesson.title)
              : '';
            const hasActualContent = lesson.content && lesson.content.trim().length > 0;
            const contentHtml = hasActualContent
              ? `<div class="prose prose-[#2B2B2B] max-w-none whitespace-pre-line text-gray-700">${escapeHtml(lesson.content)}</div>`
              : '';
            const completedNote = isCompleted && !hasActualContent ? `<p class="text-gray-600 italic mb-4">This lesson has been completed.</p>` : '';
            const bodyHtml = `${videoHtml}${completedNote}${contentHtml}`;

            content.innerHTML = `
              <div class="bg-white rounded-xl overflow-hidden border border-gray-200">
                <div class="p-6 lg:p-8">
                  <h2 class="text-2xl font-bold text-[#2B2B2B] mb-4">${escapeHtml(lesson.title)}</h2>
                  ${bodyHtml}
                  ${navButtons}
                </div>
              </div>
            `;

            const hasAnyVideo = !!lesson.video?.trim();
            if (hasAnyVideo && content) {
              const script = document.createElement('script');
              script.src = 'https://lopezinsurance.h5p.com/js/h5p-resizer.js';
              script.charset = 'UTF-8';
              content.appendChild(script);
            }

            if (!isCompleted) {
              document.getElementById('complete-lesson-btn')?.addEventListener('click', async () => {
                const btn = document.getElementById('complete-lesson-btn') as HTMLButtonElement;
                if (btn) {
                  btn.disabled = true;
                  btn.textContent = 'Saving...';
                }
                try {
                  await post<CompleteLessonResponse>(`/courses/${courseId}/complete_lesson`, {
                    course_item_id: itemId,
                  });
                  // Update UI in place: show Completed and enable Next (no navigation)
                  btn.outerHTML = completedBadgeHtml;
                  const nextLink = content?.querySelector('#lesson-next-link') as HTMLElement;
                  if (nextLink) {
                    nextLink.classList.remove('bg-gray-300', 'text-gray-500', 'cursor-not-allowed', 'pointer-events-none');
                    nextLink.classList.add('bg-[#2F7FBF]', 'text-white', 'hover:bg-[#256A9E]', 'cursor-pointer');
                  }
                } catch (e: unknown) {
                  const err = e as { body?: { error?: string; errors?: string[] } };
                  const msg = err?.body?.error || (Array.isArray(err?.body?.errors) && err.body.errors[0]) || 'Error';
                  showError(msg);
                  if (btn) {
                    btn.disabled = false;
                    btn.textContent = 'Mark as complete';
                  }
                }
              });
            }
          }
          return;
        }

        if (courseItem.item_type === 'Quiz') {
          const quizId = courseItem.item_id;
          const quiz = await get<QuizDetail>(`/quizzes/${quizId}`);
          renderQuiz(quiz, itemId, content, isCompleted, prevItem, nextItem, courseId);
          return;
        }
      } catch (e: unknown) {
        const err = e as { status?: number; body?: { error?: string; errors?: string[] } };
        if (err.status === 404) {
          const content = document.getElementById('item-content');
          const sidebar = document.getElementById('course-outline-sidebar');
          if (content) content.innerHTML = `<div class="bg-white rounded-xl p-8 text-center"><p class="text-gray-600 mb-4">This course or item was not found or you don't have access to it.</p><a href="/cursos" class="inline-flex items-center gap-2 text-[#2F7FBF] hover:underline">← Back to my courses</a></div>`;
          if (sidebar) sidebar.innerHTML = `<div class="p-4"><a href="/cursos" class="text-[#2F7FBF] hover:underline text-sm">← Back to my courses</a></div>`;
          const errEl = document.getElementById('item-error');
          if (errEl) errEl.classList.add('hidden');
          return;
        }
        const msg = err?.body?.error || (Array.isArray(err?.body?.errors) && err.body.errors[0]) || 'Error loading';
        showError(msg);
      }
    }

    function normalizeOptionKey(k: string): string {
      const s = String(k).trim().toLowerCase();
      if (s === 'true' || s === 'false') return s;
      return s;
    }

    function renderQuizReview(
      quiz: QuizDetail,
      answers: Record<string, string>,
      questionResults: QuizQuestionResult[] | undefined
    ): string {
      const resultsByQ = new Map(questionResults?.map((r) => [r.question_id, r]) ?? []);
      return quiz.questions
        .sort((a, b) => (a.position ?? 0) - (b.position ?? 0))
        .map((q) => {
          const result = resultsByQ.get(q.id);
          const userAnswer = answers[String(q.id)];
          const opts = Object.entries(q.options || {}).map(([k, v]) => {
            const keyNorm = normalizeOptionKey(k);
            const isUser = userAnswer != null && keyNorm === normalizeOptionKey(userAnswer);
            const isCorrect = result != null && keyNorm === normalizeOptionKey(result.correct_answer);
            let wrapClass = 'flex items-center gap-2 rounded-lg px-3 py-2';
            if (isCorrect && isUser) wrapClass += ' bg-green-100 border border-green-500 text-green-800';
            else if (isUser && result && !result.correct) wrapClass += ' bg-red-100 border border-red-500 text-red-800';
            else if (isCorrect && !isUser) wrapClass += ' bg-green-50 border border-green-300 text-green-700';
            else wrapClass += ' text-gray-700';
            const label = isCorrect && !isUser ? `${escapeHtml(v)} (Correct answer)` : escapeHtml(v);
            return `<div class="${wrapClass}">${label}</div>`;
          }).join('');
          const status = result?.correct ? '<span class="text-green-600 font-medium">✓ Correct</span>' : '<span class="text-red-600 font-medium">✗ Incorrect</span>';
          return `
            <div class="mb-6 p-4 border rounded-lg ${result?.correct ? 'border-green-200 bg-green-50/50' : 'border-red-200 bg-red-50/50'}">
              <div class="flex items-start justify-between gap-3 mb-3">
                <p class="font-medium text-[#2B2B2B]">${escapeHtml(q.body)}</p>
                ${result != null ? status : ''}
              </div>
              <div class="flex flex-col gap-2">${opts}</div>
            </div>
          `;
        })
        .join('');
    }

    function renderQuiz(
      quiz: QuizDetail,
      courseItemId: number,
      contentEl: HTMLElement | null,
      isCompleted: boolean,
      prevItem: { id: number; title: string; item_type: string } | null,
      nextItem: { id: number; title: string; item_type: string } | null,
      courseId: string
    ) {
      if (!contentEl) return;
      
      const questionsHtml = quiz.questions
        .sort((a, b) => (a.position ?? 0) - (b.position ?? 0))
        .map(
          (q) => {
            const opts =
              q.question_type === 'true_false'
                ? Object.entries(q.options || {})
                    .map(([k, v]) => `<label class="flex items-center gap-2"><input type="radio" name="q_${q.id}" value="${escapeHtml(k)}" /> ${escapeHtml(v)}</label>`)
                    .join('')
                : Object.entries(q.options || {})
                    .map(([k, v]) => `<label class="flex items-center gap-2"><input type="radio" name="q_${q.id}" value="${escapeHtml(k)}" /> ${escapeHtml(v)}</label>`)
                    .join('');
            return `
              <div class="mb-6 p-4 border border-gray-200 rounded-lg">
                <p class="font-medium text-[#2B2B2B] mb-3">${escapeHtml(q.body)}</p>
                <div class="flex flex-col gap-2">${opts}</div>
              </div>
            `;
          }
        )
        .join('');

      const navButtons = `
        <div class="mt-6 pt-6 border-t border-gray-200 flex items-center justify-between gap-4">
          ${prevItem ? `
            <a href="/curso/${courseId}/item/${prevItem.id}" class="flex items-center gap-2 text-[#2F7FBF] hover:text-[#256A9E] font-medium">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              Previous
            </a>
          ` : '<div></div>'}
          ${nextItem ? `
            <a href="/curso/${courseId}/item/${nextItem.id}" class="flex items-center gap-2 text-[#2F7FBF] hover:text-[#256A9E] font-medium">
              Next
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          ` : '<div></div>'}
        </div>
      `;

      if (isCompleted) {
        const hasReview = quiz.question_results != null && quiz.question_results.length > 0;
        const answersFromResults = hasReview
          ? Object.fromEntries(
              quiz.question_results!.map((r) => [String(r.question_id), r.user_answer ?? ''])
            )
          : {};
        const bodyContent = hasReview
          ? `<p class="text-gray-600 mb-6">This quiz has already been completed. Review your answers below.</p><div class="space-y-1">${renderQuizReview(quiz, answersFromResults, quiz.question_results)}</div>`
          : `<p class="text-gray-600 mb-6">This quiz has already been completed. You can review the questions.</p>${questionsHtml}`;
        contentEl.innerHTML = `
          <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <div class="p-6 border-b border-gray-200">
              <div class="flex items-center justify-between">
                <h2 class="text-2xl font-bold text-[#2B2B2B]">${escapeHtml(quiz.title)}</h2>
                <span class="flex items-center gap-2 text-green-600 font-medium">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  Completado
                </span>
              </div>
            </div>
            <div class="p-6">
              ${bodyContent}
              ${navButtons}
            </div>
          </div>
        `;
        return;
      }

      contentEl.innerHTML = `
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
          <div class="p-6 border-b border-gray-200">
            <h2 class="text-2xl font-bold text-[#2B2B2B]">${escapeHtml(quiz.title)}</h2>
          </div>
          <form id="quiz-form" class="p-6">
            ${questionsHtml}
            <div class="flex items-center justify-between gap-4">
              ${prevItem ? `
                <a href="/curso/${courseId}/item/${prevItem.id}" class="flex items-center gap-2 text-[#2F7FBF] hover:text-[#256A9E] font-medium">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                  Previous
                </a>
              ` : '<div></div>'}
              <button type="submit" class="bg-[#2F7FBF] text-white px-6 py-3 rounded-lg hover:bg-[#256A9E] font-medium cursor-pointer">Submit answers</button>
            </div>
          </form>
        </div>
      `;

      document.getElementById('quiz-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target as HTMLFormElement;
        const answers: Record<string, string> = {};
        quiz.questions.forEach((q) => {
          const input = form.querySelector(`input[name="q_${q.id}"]:checked`) as HTMLInputElement;
          if (input) answers[String(q.id)] = input.value;
        });
        const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Submitting...';
        }
        try {
          const res = await post<QuizSubmitResponse>(`/quizzes/${quiz.id}/submit`, { answers });
          if (contentEl) {
            const nextNav = res.next_item ? `<a href="/curso/${courseId}/item/${res.next_item.id}" class="text-[#2F7FBF] hover:underline">Continue</a>` : '';
            const reviewHtml = res.question_results?.length
              ? `<div class="mt-8 pt-6 border-t border-gray-200"><h3 class="text-lg font-semibold text-[#2B2B2B] mb-4">Review your answers</h3>${renderQuizReview(quiz, answers, res.question_results)}</div>`
              : '';
            contentEl.innerHTML = `
              <div class="bg-white rounded-xl p-8">
                <h2 class="text-xl font-bold text-[#2B2B2B] mb-2">Result: ${res.score}%</h2>
                <p class="text-gray-600 mb-4">${escapeHtml(res.message)}</p>
                ${res.passed ? '<p class="text-green-600 font-medium mb-2">Passed!</p>' : '<p class="text-amber-600 font-medium mb-2">You can try again.</p>'}
                ${reviewHtml}
                <div class="mt-6 pt-4">
                  ${res.course_complete ? `<a href="/curso/${courseId}" class="text-[#2F7FBF] hover:underline">Back to course</a>` : nextNav || '<button type="button" id="quiz-continue" class="bg-[#2F7FBF] text-white px-6 py-3 rounded-lg hover:bg-[#256A9E] cursor-pointer">Continue</button>'}
                </div>
              </div>
            `;
            if (res.course_complete) {
              const backLink = contentEl.querySelector('a[href*="/curso/"]');
              if (backLink && !res.next_item) (backLink as HTMLElement).innerHTML = 'Course completed – Back to course';
            } else if (res.next_item) {
              // Navigation handled by link
            } else {
              document.getElementById('quiz-continue')?.addEventListener('click', () => loadItem());
            }
          }
        } catch (err: unknown) {
          const apiErr = err as { body?: { error?: string; errors?: string[] } };
          const msg = apiErr?.body?.error || (Array.isArray(apiErr?.body?.errors) && apiErr.body.errors[0]) || 'Error submitting';
          showError(msg);
          if (btn) {
            btn.disabled = false;
            btn.textContent = 'Submit answers';
          }
        }
      });
    }

    if (courseId && itemId) loadItem();
  </script>
</BaseLayout>
